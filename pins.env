# Release-artifact-gate pins — the generation the 0th run (2026-08-31) measured.
#
# Runners RESOLVE what a user actually gets today (latest tag / npm latest /
# maven latest stable) and RECORD it next to these pins. A mismatch is a
# channel-lag finding, never a harness error: "npm latest = 0.16.0 while the
# GitHub tag is v0.16.1" is exactly the kind of row this gate exists to print.
#
# On a new release: update GEN_* here, run run_channels.sh, diff the table.

GEN_LITERTLM_TAG=v0.16.1
GEN_LITERT_TAG=v2.2.0
GEN_PYPI_LITERT_LM=0.16.1
GEN_MAVEN_LITERTLM_ANDROID=0.16.1
GEN_NPM_LITERTLM_CORE=0.16.0
GEN_NPM_LITERTJS_CORE=2.5.3

# LLM canary for install-and-generate legs (SwiftPM mac, Maven android).
# Smallest official dense litert-community ship: boring on purpose — the gate
# measures the DISTRIBUTION channel, so the model must not be the variable.
CANARY_LLM_REPO=litert-community/gemma-3-270m-it
CANARY_LLM_FILE=gemma3-270m-it-q8.litertlm

# tflite canary for the litert.js (browser) leg (small public classifier).
CANARY_TFLITE_REPO=litert-community/efficientnet_b0
CANARY_TFLITE_FILE=efficientnet_b0_weight_only_wi8_afp32.tflite
